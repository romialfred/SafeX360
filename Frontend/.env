# LOT 52 — Config locale : Frontend → Gateway local (port 9100 : le 9000
# local est occupé par MinIO du projet mjic via Docker Desktop)
# Gateway local → backends locaux → MySQL local Docker (safex-mysql)
VITE_API_URL=http://localhost:9100

# Production override (Vercel) — non utilisé en local Vite dev :
# VITE_API_URL=https://safex360-gateway.onrender.com

# ---------------------------------------------------------------------------
# Authentification Microsoft (Entra ID / Azure AD) — OPTIONNELLE
# ---------------------------------------------------------------------------
# URL absolue https du point d'entree OIDC expose par le backend. Tant qu'elle
# est absente, le bouton « Continuer avec Microsoft » reste visible mais
# inactif (aucune connexion simulee).
# Le client id, le client secret, le tenant et l'URI de redirection enregistree
# restent cote backend : AUCUN secret ne doit figurer dans ce fichier.
# VITE_MS_SSO_START_URL=https://<gateway>/hrms/auth/oauth2/microsoft